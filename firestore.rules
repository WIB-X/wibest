rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    // Admin = authenticated AND either a custom admin claim OR the designated owner email.
    // Email verification alone is NOT sufficient (anyone with a verified email could log in otherwise).
    function isAdmin() {
      return request.auth != null
          && (request.auth.token.admin == true
              || request.auth.token.email == 'hello@wibest.in');
    }

    function validReview() {
      let d = request.resource.data;
      return d.status == 'pending'
          && d.name is string   && d.name.size()  >= 1 && d.name.size()  <= 100
          && d.email is string  && d.email.size() >= 3 && d.email.size() <= 200
          && d.text is string   && d.text.size()  <= 2000
          && d.rating is number && d.rating >= 1  && d.rating <= 5
          && d.category is string
          // entityId is required for the new widget; legacy reviews don't have it.
          && (!('entityId' in d) || (d.entityId is string && d.entityId.size() <= 200));
    }

    function validContactRequest() {
      let d = request.resource.data;
      return d.parentName  is string && d.parentName.size()  >= 1 && d.parentName.size()  <= 100
          && d.parentEmail is string && d.parentEmail.size() >= 3 && d.parentEmail.size() <= 200
          && d.status == 'pending';
    }

    function validMessage() {
      let d = request.resource.data;
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.message is string && d.message.size() >= 1 && d.message.size() <= 2000;
    }

    function validContactMessage() {
      let d = request.resource.data;
      return d.name    is string && d.name.size()    >= 1  && d.name.size()    <= 100
          && d.email   is string && d.email.size()   >= 5  && d.email.size()   <= 200
          && d.subject is string && d.subject.size() >= 1  && d.subject.size() <= 100
          && d.message is string && d.message.size() >= 1  && d.message.size() <= 2000;
    }

    // ── Public content (read-only for public, write requires auth) ──────────
    match /items/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /colleges/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /electronics/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /vehicles/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /hospitals/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blog_posts/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /restaurants/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /real_estate/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /jobs/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /travel/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /accessories/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Reviews: public can create (pending only), admin manages ────────────
    match /reviews/{doc} {
      allow read: if true;   // client already filters status == 'approved'
      allow create: if validReview();
      allow update, delete: if isAdmin();
    }

    // ── Contact/enquiry requests: public can create, admin manages ──────────
    match /contact_requests/{doc} {
      allow create: if validContactRequest();
      allow read, update, delete: if isAdmin();
    }

    // ── General contact messages ─────────────────────────────────────────────
    match /messages/{doc} {
      allow create: if validMessage();
      allow read, update, delete: if isAdmin();
    }

    // ── Contact form submissions (contact/index.html) ────────────────────────
    match /contact_messages/{doc} {
      allow create: if validContactMessage();
      allow read, update, delete: if isAdmin();
    }

    // ── Newsletter subscribers: public can subscribe, admin manages ──────────
    match /newsletter_subscribers/{doc} {
      allow create: if request.resource.data.email is string
          && request.resource.data.email.size() >= 5
          && request.resource.data.email.size() <= 200;
      allow read, update, delete: if isAdmin();
    }


    // ── Price tracker: prices read-only for public; admin updates via Cloud Function ──
    match /prices/{asin} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // ── Price alerts: public can create, admin manages, owner can delete by email ──
    match /price_alerts/{doc} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.asin is string
                    && request.resource.data.targetPrice is number
                    && request.resource.data.targetPrice > 0;
      allow read, update, delete: if isAdmin();
    }

    // ── AI query log: written by Cloud Function (admin SDK bypasses rules), read by admin only ──
    match /ai_query_log/{doc} {
      allow read: if isAdmin();
      allow write: if false;  // only admin SDK writes
    }

    // ── Finance lead-gen forms: public can create, admin manages ──
    match /finance_leads/{doc} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() == 10
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.category is string;
      allow read, update, delete: if isAdmin();
    }

    // ── Deny everything else by default ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
